# Copy thành .env (cạnh docker-compose.yml, ở thư mục cha) rồi sửa.
# Các thư mục cạnh docker-compose.yml:
SOURCE_DIR=./source
HERON_MODEL_DIR=./docling-layout-heron
VLLM_MODEL_DIR=./qwen
# vLLM chạy sẵn trên máy chủ:
QWEN_OCR_BASE_URL=http://host.docker.internal:8002/v1
# Dùng service vllm trong compose thì đổi thành:
# QWEN_OCR_BASE_URL=http://vllm:8002/v1
QWEN_OCR_MODEL=qwen-ocr
QWEN_OCR_API_KEY=EMPTY
# Mức log: DEBUG (thêm từng vùng OCR), INFO, WARNING, ERROR
LOG_LEVEL=INFO
