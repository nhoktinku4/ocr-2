# Copy thành .env rồi sửa.
API_PORT=8000
# vLLM chạy sẵn trên máy chủ:
QWEN_OCR_BASE_URL=http://host.docker.internal:8002/v1
# Dùng service vllm trong compose thì đổi thành:
# QWEN_OCR_BASE_URL=http://vllm:8002/v1
QWEN_OCR_MODEL=qwen-ocr
QWEN_OCR_API_KEY=EMPTY
# Chỉ cần khi chạy --profile vllm:
VLLM_MODEL=
